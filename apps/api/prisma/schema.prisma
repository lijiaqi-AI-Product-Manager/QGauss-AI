// QGauss AI · 域模型 v2
//
// v2 相对 v1 的结构性修正（采纳架构评审）：
//   1. 删除 Provider 表 —— 协议类型下沉为 Channel.type；upstreamName 移到 ModelChannel，
//      同一逻辑模型可挂多个来源（官方/Azure/中转）。
//   2. 删除 User.tenantId —— 半套多租户比没有更危险，归属边界统一用 userId。
//   3. Channel 只存管理员意图（status），运行时健康度/熔断不落库。
//   4. apiKey 加密存储（apiKeyEnc），只保留末 4 位用于掩码展示。
//   5. Session 改名 RefreshToken，带 familyId / replacedById / usedAt，支持轮换链与盗用检测。
//   6. Message 补齐 parentId / reasoning / parts / 输入输出 token / finishReason 等。
//   7. 新增 UsageRecord（用量与价格快照）、ChatAttempt（每次上游尝试）。
//   8. 主键统一 cuid；软删除统一 deletedAt。
//
// 仍保持 provider 无关：枚举用 String、JSON 用 TEXT、金额用整数（微单位）。
// 切 PostgreSQL 只需改 datasource 两行。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  emailVerifiedAt DateTime?
  username     String    @unique
  passwordHash String
  displayName  String?
  avatar       String?
  signature    String    @default("")
  role         String    @default("USER") // USER | ADMIN | SUPER（SUPER 暂未启用）
  status       String    @default("ACTIVE") // ACTIVE | DISABLED
  tokenVersion Int       @default(0) // 改密/封禁时 +1，立即作废 access token
  // ---- 分销----
  inviteCode     String?  @unique // 邀请码，10 位；惰性生成
  invitedBy      String   @default("") // 邀请人的 inviteCode
  isDistribution Boolean  @default(false) // 是否具备分销资格（决定分销菜单可见性）
  adminNote      String   @default("") // 仅管理端使用，不进入个人资料和登录响应
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  refreshTokens RefreshToken[]
  agentFavorites AgentFavorite[]
  agentFiles     AgentFileMapping[]
  agentRuns      AgentRun[]
  conversations Conversation[]
  usageRecords  UsageRecord[]
  uploads       UploadFile[]
  artifactSaves AgentArtifactSave[]
  uploadReceipts UploadReceipt[]
  avatarUploads UserAvatarUpload[]
  passwordResets PasswordReset[]
  emailVerifications EmailVerification[]
  createdApps App[] @relation("UserCreatedApps")
  userBalance   UserBalance?
  balance       Balance?
  reservations  CountReservation[]
  voiceTasks    VoiceTask[]
  galleryFavorites GalleryFavorite[]
  mindmapDocuments MindmapDocument[]
  mindmapOperations MindmapOperation[]
  mindmapGenerations MindmapGeneration[]
  extensionRequests ExtensionRequest[]
  voiceRequests VoiceRequest[]
  videoRequests VideoRequest[]

  @@map("users")
}

model UserAvatarUpload {
  id String @id @default(cuid())
  userId String
  requestKey String
  inputHash String?
  version Int @default(1)
  status String @default("PROCESSING")
  stageJson String?
  fileId String?
  errorCode String?
  acceptedDay String
  familyId String
  tokenVersion Int
  accessExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([userId, requestKey])
  @@index([userId, acceptedDay])
  @@index([status, updatedAt])
  @@map("user_avatar_uploads")
}

model UserAccountOperation {
  id String @id
  actorId String
  userId String
  requestKey String
  kind String
  payloadHash String
  resultJson String
  createdAt DateTime @default(now())
  @@unique([actorId, requestKey])
  @@index([userId, createdAt, id])
  @@map("user_account_operations")
}

model MindmapDocument {
  id String @id @default(cuid())
  userId String
  title String
  outline String
  nodeCount Int
  version Int @default(1)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, archivedAt, updatedAt])
  @@map("mindmap_documents")
}

model MindmapOperation {
  id String @id @default(cuid())
  userId String
  requestKey String
  kind String
  payloadHash String
  state String @default("APPLIED")
  documentId String?
  documentVersion Int?
  generationId String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([userId, requestKey])
  @@map("mindmap_operations")
}

model MindmapGeneration {
  id String @id @default(cuid())
  userId String
  requestKey String
  modelId String
  modelName String
  modelDisplayName String
  channelId String
  routeRevision String
  prompt String
  context String @default("")
  title String
  maxOutput Int
  status String @default("QUEUED")
  outline String @default("")
  promptTokens Int @default(0)
  completionTokens Int @default(0)
  priceInPerM Int @default(0)
  priceOutPerM Int @default(0)
  costMicros Int @default(0)
  estimated Boolean @default(false)
  usageId String? @unique
  pool String @default("model3")
  reservedAmount Int @default(0)
  chargedAmount Int @default(0)
  returnedAmount Int @default(0)
  expiredAmount Int @default(0)
  billingState String @default("FREE")
  errorCode String?
  errorMessage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  startedAt DateTime?
  finishedAt DateTime?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@map("mindmap_generations")
}

model EmailVerification {
  id String @id
  email String
  purpose String
  userId String?
  tokenVersion Int?
  codeHash String
  ipHash String
  attempts Int @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt DateTime?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([email, purpose, createdAt])
  @@index([ipHash, createdAt])
  @@map("email_verifications")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  familyId     String // 同一次登录派生的整条轮换链
  tokenHash    String    @unique // sha256(随机 32 字节)
  replacedById String?
  usedAt       DateTime?
  revokedAt    DateTime?
  expiresAt    DateTime
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Native voice uses the existing encrypted channel credentials; no copied secrets.
model VoiceConfig {
  id                     String   @id @default("site")
  enabled                Boolean  @default(false)
  speechChannelId        String   @default("")
  transcriptionChannelId String   @default("")
  speechModel            String   @default("tts-1")
  transcriptionModel     String   @default("whisper-1")
  speechCost             Int      @default(0)
  transcriptionCost      Int      @default(0)
  pool                   String   @default("model3")
  maxSpeechChars         Int      @default(16000)
  retentionDays          Int      @default(0)
  version                Int      @default(1)
  updatedAt              DateTime @updatedAt
  @@map("voice_config")
}

/// Client intent, accepted quote and staged result survive disconnects and restarts.
model VoiceTask {
  request VoiceRequest?
  id               String    @id @default(cuid())
  userId           String
  requestKey       String
  requestHash      String
  label            String    @default("")
  retentionDays    Int       @default(0)
  expiresAt        DateTime?
  deletedAt        DateTime?
  purgedAt         DateTime?
  kind             String
  messageId        String?
  inputFileId      String?
  sample           Boolean   @default(false)
  voice            String    @default("fable")
  model            String
  channelId        String
  configVersion    Int
  status           String    @default("QUEUED")
  progress         Int       @default(0)
  inputChars       Int       @default(0)
  inputSeconds     Float     @default(0)
  segmentCount     Int       @default(1)
  completedSegments Int      @default(0)
  attemptedSegments Int      @default(0)
  transcript       String    @default("")
  resultJson       String    @default("[]")
  pool             String    @default("model3")
  reservedAmount   Int       @default(0)
  chargedAmount    Int       @default(0)
  returnedAmount   Int       @default(0)
  expiredAmount    Int       @default(0)
  billingState     String    @default("FREE")
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  finishedAt       DateTime?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([userId, deletedAt, createdAt])
  @@index([expiresAt, purgedAt])
  @@map("voice_tasks")
}

model Channel {
  id          String    @id @default(cuid())
  name        String    @unique
  type        String    @default("CUSTOM") // OPENAI | OPENAI_RESPONSES | ANTHROPIC | GEMINI | CUSTOM | MOCK
  baseUrl     String
  apiKeyEnc   String    @default("") // "v1:" + base64(iv|tag|ciphertext)
  apiKeyLast4 String    @default("")
  priority    Int       @default(0) // 数字小的优先
  weight      Int       @default(1)
  status      String    @default("ENABLED")
  timeoutMs   Int       @default(60000)
  extra       String? // 协议特有参数（组织 ID、api-version 等），JSON 文本
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  models ModelChannel[]

  @@map("channels")
}

model AiModel {
  id           String    @id @default(cuid())
  name         String    @unique // 对外逻辑名
  displayName  String
  // 模型广场的展示元数据（管理员在「模型管理」里维护）
  vendor       String    @default("") // 厂商：OpenAI / Anthropic / DeepSeek / 自定义...
  description  String    @default("") // 一句话介绍，广场卡片用
  tags         String    @default("") // 逗号分隔：视觉,推理,工具,长上下文
  badge        String    @default("") // 角标：HOT / NEW / 推荐，空串不显示
  maxContext   Int       @default(8192)
  maxOutput    Int       @default(2048)
  capabilities String    @default("chat") // chat,vision,reasoning,tools
  priceInPerM  Int       @default(0) // 微单位 / 百万 token
  priceOutPerM Int       @default(0)
  // 次数计费：
  //   countPool 为空表示纯 token 计费；model3/model4 表示每次对话另扣该池次数
  countPool    String    @default("")
  countCost    Int       @default(0)
  status       String    @default("ENABLED")
  sort         Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  channels      ModelChannel[]
  conversations Conversation[]

  @@map("models")
}

/// 渠道的额外 Key（主 Key 仍在 channels.apiKeyEnc）。不建外键，随渠道软删一起过滤
model ChannelKey {
  id         String    @id @default(cuid())
  channelId  String
  keyEnc     String
  /// sha256(明文)，同一渠道内去重
  keyHash    String
  last4      String    @default("")
  weight     Int       @default(1)
  /// ENABLED | DISABLED（上游 401/403 会自动置为 DISABLED）
  status     String    @default("ENABLED")
  failCount  Int       @default(0)
  lastError  String?
  lastUsedAt DateTime?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([channelId, keyHash])
  @@index([channelId, status])
  @@map("channel_keys")
}

model ModelChannel {
  modelId      String
  channelId    String
  upstreamName String // 该渠道上的真实模型名（Azure 是部署名）
  weight       Int     @default(1)
  enabled      Boolean @default(true)

  model   AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([modelId, channelId])
  @@index([channelId])
  @@map("model_channels")
}

model Conversation {
  id            String    @id @default(cuid())
  version       Int       @default(1)
  userId        String
  modelId       String?
  folderId      String?
  appId         String?
  agentId       String?
  title         String    @default("新对话")
  systemPrompt  String?
  params        String? // temperature 等，JSON 文本
  pinnedAt      DateTime? // 比 Boolean 多一个排序维度
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  model    AiModel?  @relation(fields: [modelId], references: [id], onDelete: SetNull)
  app      App?      @relation(fields: [appId], references: [id], onDelete: SetNull)
  agent    Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  messages Message[]
  extensionRequest ExtensionRequest?

  @@index([userId, lastMessageAt])
  @@index([userId, appId, lastMessageAt])
  @@index([userId, agentId, lastMessageAt])
  @@index([userId, deletedAt, pinnedAt, lastMessageAt, id])
  @@map("conversations")
}

model Message {
  id               String    @id @default(cuid())
  conversationId   String
  parentId         String? // 重新生成/编辑形成分支
  clientMsgId      String? // 前端生成，幂等去重
  role             String // SYSTEM | USER | ASSISTANT
  status           String    @default("COMPLETED") // PENDING | STREAMING | SETTLING | COMPLETED | ABORTED | FAILED
  content          String    @default("")
  reasoning        String? // 推理模型的思考内容
  parts            String? // 多模态/工具调用，JSON 文本
  searchJson       String? // Normalized provider-managed search receipt; raw payloads are not stored.
  agentJson        String? // Public activity receipt; provider identifiers live in AgentRun only.
  modelName        String? // 快照，模型删除后仍可展示
  modelId          String? // 不建外键
  channelId        String? // 不建外键
  promptTokens     Int?
  completionTokens Int?
  usageEstimated   Boolean   @default(false)
  finishReason     String?
  errorCode        String?
  ttfbMs           Int?
  durationMs       Int?
  billingState     String    @default("LEGACY") // LEGACY | FREE | RESERVED | SETTLING | SETTLED | RELEASED
  billingPool      String    @default("")
  reservedAmount   Int       @default(0)
  chargedAmount    Int       @default(0)
  returnedAmount   Int       @default(0)
  expiredAmount    Int       @default(0)
  settlementJson   String? // 已保存回复的结算快照；不向客户端返回
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?
  artifactSaves AgentArtifactSave[]

  @@unique([conversationId, clientMsgId])
  @@index([conversationId, createdAt])
  @@index([createdAt, id])
  @@index([conversationId, parentId, createdAt, id])
  @@index([status, updatedAt])
  @@map("messages")
}

model UsageRecord {
  id               String   @id @default(cuid())
  userId           String
  messageId        String?  @unique
  kind             String   @default("chat") // chat / image / video
  modelName        String
  channelId        String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  priceInPerM      Int      @default(0) // 价格快照
  priceOutPerM     Int      @default(0)
  costMicros       Int      @default(0)
  estimated        Boolean  @default(false)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("usage_records")
}

model ChatAttempt {
  id         String   @id @default(cuid())
  messageId  String
  attemptNo  Int
  channelId  String
  outcome    String // ok | retryable | fatal
  httpStatus Int?
  errorCode  String?
  ttfbMs     Int?
  createdAt  DateTime @default(now())

  @@index([messageId])
  @@index([channelId, createdAt])
  @@map("chat_attempts")
}

model GlobalConfig {
  key       String   @id
  value     String   @default("{}") // JSON；可编辑配置命中注册表，installation.state 仅供安装流程读写
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("global_configs")
}

model SensitiveWord {
  id        String    @id @default(cuid())
  word      String    @unique
  category  String    @default("general")
  action    String    @default("block") // block | review
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([enabled])
  @@map("sensitive_words")
}

model ModerationHit {
  id             String   @id @default(cuid())
  userId         String
  word           String
  source         String   @default("chat") // chat | profile
  excerpt        String?
  conversationId String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("moderation_hits")
}

model PresetGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  presets Preset[]

  @@map("preset_groups")
}

model Preset {
  id        String    @id @default(cuid())
  groupId   String?
  title     String
  prompt    String
  icon      String?
  sort      Int       @default(0)
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  group PresetGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([groupId, sort])
  @@map("presets")
}

model UploadFile {
  id        String    @id @default(cuid())
  userId    String
  scope     String    @default("chat") // chat | avatar | other
  filename  String // 用户原始文件名（仅展示）
  storedKey String    @unique // 存储键，如 2026/10/uuid.png
  mime      String
  size      Int
  sha256    String
  backend   String    @default("local")
  /// 对话附件的文本提取缓存（PDF / Word / Excel / 文本）；NULL = 尚未解析
  extractedText String?
  extractError  String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  expiresAt DateTime?
  purgedAt  DateTime?
  trashedAt DateTime?
  version   Int @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentFiles AgentFileMapping[]

  @@index([userId, createdAt])
  @@index([sha256])
  @@index([scope, deletedAt, purgedAt])
  @@map("upload_files")
}

model AgentArtifactSave {
  id String @id @default(cuid())
  userId String
  messageId String
  artifactKey String
  version Int @default(1)
  status String @default("QUEUED")
  sourceUrl String
  title String
  stageJson String?
  fileId String?
  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  message Message @relation(fields:[messageId],references:[id],onDelete:Cascade)
  @@unique([userId,messageId,artifactKey])
  @@index([status,createdAt])
  @@index([userId,status])
  @@map("agent_artifact_saves")
}

model UploadReceipt {
  id String @id @default(cuid())
  userId String
  requestKey String
  inputHash String
  version Int @default(1)
  status String @default("STORING")
  stageJson String
  fileId String?
  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,requestKey])
  @@index([status,updatedAt])
  @@map("upload_receipts")
}

model Menu {
  id        String   @id @default(cuid())
  parentId  String?
  title     String
  path      String
  icon      String?
  sort      Int      @default(0)
  visible   Boolean  @default(true)
  roles     String   @default("ADMIN") // 逗号分隔，如 "ADMIN" 或 "ADMIN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, sort])
  @@map("menus")
}

model ConversationFolder {
  id        String   @id @default(cuid())
  version   Int      @default(1)
  userId    String
  name      String
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sort])
  @@map("conversation_folders")
}

model MailOutbox {
  id        String    @id @default(cuid())
  to        String
  subject   String
  template  String
  payload   String? // 模板变量 JSON
  body      String? // 渲染后的正文
  status    String    @default("queued") // queued | sending | sent | failed | skipped | suppressed | unknown
  error     String?
  /// 已尝试投递次数（含首发；达到上限后不再自动重试）
  attempts   Int       @default(0)
  /// 最后一次尝试时间，用于排查"卡了多久"
  lastTriedAt DateTime?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  /// Admin delivery probes are bound to their initiating account and explicit request.
  requestedById String?
  requestKey    String?
  /// Attempt ownership; never returned to a browser.
  dispatchToken String?
  /// A human acknowledgement, separate from SMTP acceptance.
  confirmedAt   DateTime?

  @@index([createdAt])
  @@index([status])
  @@index([requestedById, createdAt])
  @@unique([requestedById, requestKey])
  @@map("mail_outbox")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model AgentConnection {
  id          String    @id @default(cuid())
  name        String
  provider    String    @default("COZE")
  baseUrl     String
  authMode    String    @default("JWT")
  appId       String?
  publicKeyId String?
  secretEnc   String    @default("")
  spaceId     String?
  enabled     Boolean   @default(true)
  version     Int       @default(1)
  timeoutMs   Int       @default(60000)
  lastProbeAt DateTime?
  lastProbeOk Boolean?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  agents      Agent[]
  files       AgentFileMapping[]
  runs        AgentRun[]

  @@index([enabled, deletedAt])
  @@map("agent_connections")
}

model Agent {
  id                 String    @id @default(cuid())
  connectionId       String
  botId              String
  name               String
  description        String    @default("")
  greeting           String    @default("")
  tagsJson           String    @default("[]")
  questionsJson      String    @default("[]")
  metadataJson       String    @default("{}")
  countCost          Int       @default(1)
  published          Boolean   @default(false)
  sort               Int       @default(0)
  lastSyncAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  connection         AgentConnection @relation(fields: [connectionId], references: [id])
  favorites          AgentFavorite[]
  conversations      Conversation[]
