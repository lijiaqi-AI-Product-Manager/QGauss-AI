// ============================================================================
// 商业化域（v1.1 批 1 · 账本与支付内核）
//
// 约定（与 v2 域模型一致，不引入浮点）：
//   - 钱包/订单金额用整数「分」（*Cents），不用 Decimal / Float。
//     上限 Int 21.47 亿分 ≈ 2147 万元，够用；单次用量成本仍用「微」（costMicros）。
//   - 次数（count）是主要计费维度，四个池：model3 / model4 / drawMj / agent。
//   - 余额只允许经 LedgerService 的事务改动，任何裸 update 都视为缺陷。
//   - 账本日志不可变（不可更新/删除），只追加。
// ============================================================================

/// 次数余额：购买次数 + 会员每日次数 + 累计用量
model UserBalance {
  id                String    @id @default(cuid())
  userId            String    @unique
  /// 购买的剩余次数（永久有效，除套餐过期）
  model3Count       Int       @default(0)
  model4Count       Int       @default(0)
  drawMjCount       Int       @default(0)
  agentCount        Int       @default(0)
  /// 会员每日额度（每天 0 点按 Asia/Shanghai 重置）
  memberModel3Count Int       @default(0)
  memberModel4Count Int       @default(0)
  memberDrawMjCount Int       @default(0)
  memberAgentCount  Int       @default(0)
  /// 会员每日额度上限（重置时的目标值，来自套餐）
  dailyModel3Count  Int       @default(0)
  dailyModel4Count  Int       @default(0)
  dailyDrawMjCount  Int       @default(0)
  dailyAgentCount   Int       @default(0)
  /// 累计已用（只增不减，用于统计与风控）
  useModel3Count    Int       @default(0)
  useModel4Count    Int       @default(0)
  useModel3Token    Int       @default(0)
  useModel4Token    Int       @default(0)
  useDrawMjToken    Int       @default(0)
  useAgentCount     Int       @default(0)
  /// 当前套餐快照与会员到期时间
  packageId         String    @default("")
  extent            String    @default("")
  expirationTime    DateTime?
  /// 会员每日额度上次重置日期（yyyy-MM-dd，Asia/Shanghai）
  memberResetOn     String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_balances")
}

/// 账户余额：金额 + 绘图/工具次数
model Balance {
  id           String   @id @default(cuid())
  userId       String   @unique
  balanceCents Int      @default(0)
  usesLeft     Int      @default(0)
  paintCount   Int      @default(0)
  useTokens    Int      @default(0)
  useChats     Int      @default(0)
  usePaints    Int      @default(0)
  agentBalance Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("balances")
}

/// 消费流水：扣费与退款的唯一审计来源
model BalanceConsumeLog {
  id             String   @id @default(cuid())
  userId         String
  /// 1 消费结算 | 2 失败返还 | 3 失败免扣 | 4 次数预留 | 5 预留释放 | 6 预留到期
  direction      Int      @default(1)
  /// model3 | model4 | mjDraw | agent | money
  deductionType  String
  /// 正数
  amount         Int
  /// 实际变动的字段名，返还时按此加回
  balanceKey     String
  /// chat | draw | agent | video | other
  bizType        String   @default("other")
  model          String   @default("")
  modelName      String   @default("")
  useAmount      Int      @default(0)
  /// 业务侧引用（messageId / imageTaskId / orderId）
  refId          String   @default("")
  /// 退款指向原扣费；预留结算 / 释放 / 到期指向原预留流水
  sourceLogId    String?
  refunded       Boolean  @default(false)
  upstreamStatus Int?
  /// 已脱敏、可展示给用户的说明
  remark         String   @default("")
  /// 流水号，用于对账与幂等
  uid            String   @unique
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([refId])
  @@index([deductionType, createdAt])
  @@map("balance_consume_logs")
}

/// 已接受任务的次数授权。余额在预留时移出可用，结算不再次扣减。
model CountReservation {
  refId           String   @id
  userId          String
  pool            String
  amount          Int
  memberAmount    Int
  paidAmount      Int
  memberDay       String
  memberExpiresAt DateTime?
  memberLogId     String?
  paidLogId       String?
  status          String   @default("HELD") // HELD SETTLED RELEASED
  settledAmount   Int      @default(0)
  returnedAmount  Int      @default(0)
  expiredAmount   Int      @default(0)
  bizType         String
  model           String   @default("")
  modelName       String   @default("")
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("count_reservations")
}

/// 充值/发放流水
model AccountLog {
  id           String   @id @default(cuid())
  userId       String
  pkgName      String   @default("")
  packageId    String   @default("")
  memberDays   Int      @default(0)
  /// admin | crami | order | gift | signin
  rechargeType String   @default("admin")
  model3Count  Int      @default(0)
  model4Count  Int      @default(0)
  drawMjCount  Int      @default(0)
  agentCount   Int      @default(0)
  days         Int      @default(0)
  amountCents  Int      @default(0)
  rebateUserId String   @default("")
  uid          String   @unique
  extent       String   @default("")
  remark       String   @default("")
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([rechargeType, createdAt])
  @@map("account_logs")
}

/// 套餐：卡密与直购共用的商品定义
model CramiPackage {
  id          String    @id @default(cuid())
  name        String
  nameEn      String    @default("")
  nameTw      String    @default("")
  des         String    @default("")
  desEn       String    @default("")
  desTw       String    @default("")
  coverImg    String    @default("")
  priceCents  Int       @default(0)
  /// 越大越靠前
  sort        Int       @default(100)
  /// 1 上架 | 0 下架
  status      Int       @default(1)
  weight      Int       @default(0)
  /// 会员天数；0 表示不送会员，-1 表示不限
  days        Int       @default(0)
  model3Count Int       @default(0)
  model4Count Int       @default(0)
  drawMjCount Int       @default(0)
  agentCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([status, sort])
  @@map("crami_packages")
}

/// 卡密
model Crami {
  id          String    @id @default(cuid())
  code        String    @unique
  /// 1 普通（一码一用）| 2 单人一次（同一用户只可用一次）
  cramiType   Int       @default(1)
  packageId   String
  /// 0 未使用 | 1 已使用 | 2 已作废
  status      Int       @default(0)
  useId       String    @default("")
  days        Int       @default(0)
  model3Count Int       @default(0)
  model4Count Int       @default(0)
  drawMjCount Int       @default(0)
  agentCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  usedAt      DateTime?

  @@index([status, createdAt])
  @@index([packageId])
  @@map("cramis")
}

/// 卡密核销记录。cramiType=2（一人一次）靠 (cramiId,userId) 唯一键保证，
/// 同时也作为「我的兑换记录」的数据源 —— 只靠 Crami.useId 无法表达多次核销。
model CramiUse {
  id        String   @id @default(cuid())
  cramiId   String
  cramiCode String
  userId    String
  packageId String   @default("")
  /// 核销时的卡密类型快照：1 一码一用 | 2 同一用户限用一次
  cramiType Int      @default(1)
  /// 本次核销实际发放的快照（卡密被删也不丢失）
  days        Int    @default(0)
  model3Count Int    @default(0)
  model4Count Int    @default(0)
  drawMjCount Int    @default(0)
  agentCount  Int    @default(0)
  /// 对应的发放流水，便于对账（AccountLog.id）
  accountLogId String @default("")
  createdAt DateTime @default(now())

  @@unique([cramiId, userId])
  @@index([userId, createdAt])
  @@map("crami_uses")
}

/// 订单
model Order {
  id          String    @id @default(cuid())
  /// uuid v1 去横线，32 位
  orderId     String    @unique
  /// 第三方交易号
  tradeId     String    @default("")
  /// epay | hupi | mock | manual
  payPlatform String    @default("")
  userId      String
  goodsId     String
  /// package | crami | money
  goodsType   String    @default("package")
  goodsName   String    @default("")
  count       Int       @default(1)
  priceCents  Int
  totalCents  Int
  /// Client intent key: same user/key retries return the original accepted order.
  requestKey  String?
  requestHash String    @default("")
  /// Immutable package entitlements accepted when the order was created.
  goodsSnapshot String  @default("")
  expiresAt   DateTime?
  /// 0 未支付 | 1 已支付 | 2 支付失败 | 3 已超时 | 4 已退款
  status      Int       @default(0)
  paydAt      DateTime?
  /// 支付渠道标识（alipay / wxpay / …）
  channel     String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([tradeId])
  @@unique([userId, requestKey])
  @@map("orders")
}

/// 支付回调原始记录：出问题时可重放、可对账
model PayNotify {
  id          String   @id @default(cuid())
  provider    String
  orderId     String   @default("")
  tradeId     String   @default("")
  verified    Boolean  @default(false)
  handled     Boolean  @default(false)
  amountCents Int      @default(0)
  error       String   @default("")
  ip          String   @default("")
  raw         String   @default("")
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@map("pay_notifies")
}

/// 分销账户
model SalesUser {
  id                String   @id @default(cuid())
  userId            String   @unique
  /// 佣金比例，万分比（1000 = 10%）
  performanceBps    Int      @default(0)
  salesOutletName   String   @default("")
  salesOutletNameEn String   @default("")
  salesOutletNameTw String   @default("")
  totalCents        Int      @default(0)
  withdrawalCents   Int      @default(0)
  /// 可提现余额
  distributionCents Int      @default(0)
  drawMoneyInCents  Int      @default(0)
  orderCount        Int      @default(0)
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("sales_users")
}

/// 佣金记录
model SalesRecord {
  id              String   @id @default(cuid())
  inviterUserId   String
  inviteeUserId   String
  orderId         String
  orderCents      Int
  commissionCents Int
  commissionBps   Int
  settled         Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([inviterUserId, createdAt])
  @@index([orderId])
  @@map("sales_records")
}

/// 提现申请
model SalesOrder {
  id          String    @id @default(cuid())
  userId      String
  amountCents Int
  /// Same user and intent retries return the original withdrawal without freezing twice.
  requestKey  String?
  requestHash String    @default("")
  /// 0 待审核 | 1 已通过 | 2 已驳回
  orderStatus Int       @default(0)
  auditStatus Int       @default(0)
  auditUserId String    @default("")
  /// 0 未打款 | 1 已打款
  paymentStatus Int     @default(0)
  /// 1 支付宝 | 2 微信 | 3 银行卡
  channels    Int       @default(1)
  contact     String    @default("")
  remark      String    @default("")
  createdAt   DateTime  @default(now())
  auditedAt   DateTime?

  @@index([userId, createdAt])
  @@index([orderStatus])
  @@unique([userId, requestKey])
  @@map("sales_orders")
}

/// 签到
model Signin {
  id         String   @id @default(cuid())
  userId     String
  /// yyyy-MM-dd（Asia/Shanghai）
  signInDate String
  signInTime DateTime @default(now())
  /// 本次签到奖励的次数
  reward     Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([userId, signInDate])
  @@index([userId, createdAt])
  @@map("signins")
}

model GalleryFavorite {
  id String @id @default(cuid())
  userId String
  kind String
  taskId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, kind, taskId])
  @@index([kind, taskId])
  @@index([userId, createdAt])
  @@map("gallery_favorites")
}

model Extension {
  id String @id
  title String
  description String @default("")
  entryUrl String
  icon String @default("apps")
  tone String @default("violet")
  sort Int @default(0)
  enabled Boolean @default(true)
  roles String @default("USER,ADMIN")
  chatEnabled Boolean @default(false)
  legacyBridge Boolean @default(false)
  modelId String?
  version Int @default(1)
  lastRequestKey String?
  lastRequestHash String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requests ExtensionRequest[]
  @@index([deletedAt, enabled, sort])
  @@map("extensions")
}

model ExtensionRequest {
  id String @id
  userId String
  requestKey String
  extensionId String?
  extensionVersion Int
  extensionTitle String
  entryUrl String
  conversationId String? @unique
  messageId String? @unique
  prompt String
  payloadHash String
  quoteRevision String
  modelId String
  modelName String
  state String @default("READY")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  extension Extension? @relation(fields:[extensionId], references:[id], onDelete:Restrict)
  conversation Conversation? @relation(fields:[conversationId], references:[id], onDelete:Cascade)
  @@unique([userId,requestKey])
  @@index([userId,createdAt])
  @@map("extension_requests")
}

model VoiceRequest {
  id String @id
  userId String
  requestKey String
  taskId String? @unique
  state String @default("ACCEPTED")
  sourceKind String @default("unknown")
  title String @default("")
  text String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  task VoiceTask? @relation(fields:[taskId], references:[id], onDelete:SetNull)
  @@unique([userId,requestKey])
  @@index([userId,createdAt])
  @@map("voice_requests")
}
