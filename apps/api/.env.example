# 复制为 .env 后按需修改

# SQLite（默认，零依赖）
DATABASE_URL="file:./dev.db"
# PostgreSQL（需同时把 prisma/schema.prisma 的 provider 改为 postgresql）
# DATABASE_URL="postgresql://qgauss:qgauss@127.0.0.1:5433/qgauss?schema=public"

PORT=9520
NODE_ENV=development
API_PREFIX=api

# 默认不信任转发头；只有部署在明确的反向代理后面才填写其 IP/CIDR（例如 loopback）
TRUST_PROXY="false"
# 跨域来源，用逗号分隔。生产留空仅支持同源；开发留空允许本机 :5173
CORS_ORIGINS=""

# JWT 签名密钥（必须配置；生产拒绝示例值和不足 32 字符的值）
JWT_SECRET="change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# 上游 apiKey 加密密钥：32 字节 base64，生产必填，不能与 JWT_SECRET 相同
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# 首次生产安装：npm run setup:guided 生成独立随机凭证；仅在 /setup 表单中填写，不放入 URL。
# 已有站点无需配置；保留为注释，避免空值被误当作已配置。不要复用 JWT 或加密密钥。
# QGAUSS_SETUP_TOKEN=

# 上游出网限制
ALLOW_HTTP_UPSTREAM=0
UPSTREAM_HOST_ALLOWLIST=""
UPSTREAM_PORT_ALLOWLIST="443,80,11434"

SEED_ADMIN_EMAIL="admin@local.dev"
SEED_ADMIN_USERNAME="admin"
# 开发用默认密码；生产 seed 必须显式提供 12–32 位含字母和数字的密码
SEED_ADMIN_PASSWORD="admin123456"

# ---- 对象存储（可选）----
# local（默认，落本地盘）| s3（任意 S3 兼容服务：AWS / MinIO / COS 等）
STORAGE_DRIVER=local
# 仅 STORAGE_DRIVER=s3 时必填
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# MinIO 等私有部署一般需要 path-style；AWS 可设 false 走 virtual-host
S3_FORCE_PATH_STYLE=true
S3_TIMEOUT_MS=30000
S3_RETRIES=2

# ---- 发件（可选；未配置只保留记录，不会发信）----
# 修改后重新启动服务。生产必须使用直接 TLS 或 STARTTLS。
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURE=true
# MAIL_SMTP_REQUIRE_TLS=true
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
# MAIL_FROM="QGauss AI <sender@example.com>"
# 连接/问候/套接字等待：1000–60000 毫秒；最多尝试 3 次。
# MAIL_CONNECTION_TIMEOUT_MS=20000
# MAIL_GREETING_TIMEOUT_MS=10000
# MAIL_SOCKET_TIMEOUT_MS=30000
# MAIL_RETRY_INTERVAL_MS=300000

# ---- 手机验证（可选；未配置时保留号码与密码登录，不发送短信）----
# 在服务端加载短信凭据。签名和模板须已通过服务商审核；修改后重启。
# SMS_ENABLED=true
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=QGauss AI
# SMS_TEMPLATE_CODE=
# SMS_CODE_VARIABLE=code
# SMS_SECURITY_TOKEN=

# External identity sign-in. Keep disabled until the account and callback are configured.
EXTERNAL_ENABLED=false
EXTERNAL_APP_ID=
EXTERNAL_APP_SECRET=
EXTERNAL_CALLBACK_TOKEN=
EXTERNAL_ENCODING_AES_KEY=
EXTERNAL_PUBLIC_ORIGIN=
EXTERNAL_ACCOUNT_ID=
